[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"
PIPENV_VENV_IN_PROJECT = 1

[scripts]
dev = "fastapi dev main.py"
start = "fastapi run main.py"
colorize = "python colorize_svg.py" # make sure to run this in a sh, bash or zsh shell
# dev = "uvicorn main:app --reload"
# start = "uvicorn main:app"
# test = "pytest"
lint = "ruff check"

[packages]
# What the app imports at runtime (Vercel installs only this section).
fastapi = "*"
python-multipart = "*"
httpx = "*"
uvicorn = "*"

[dev-packages]
# `pipenv run dev` / `start` (fastapi dev / fastapi run) and the checks.
fastapi-cli = "*"
ruff = "*"
pytest = "*"

[requires]
python_version = "3.12"
